# コミュニティ投稿API（server/community.ts）の運用設定

# COMMUNITY_SALT: 投票・重複投稿ガード用のソルト（IPはこのソルト付きSHA-256ハッシュで保存）。
# 未設定だと起動ごとにランダム生成され、「IP毎1回」ガードが再起動のたびに
# リセットされてしまうため、必ず固定の長いランダム文字列を設定すること。
COMMUNITY_SALT="CHANGE_ME__LONG_RANDOM_STRING"

# COMMUNITY_BACKEND: community persistence backend。
# 開発/testは未指定なら json。本番は明示指定必須。
# firestore を指定すると @google-cloud/firestore を使用する。実データ切替前に
# Firestore DB作成・IAM・migration/parity・rollback手順を別途完了させること。
COMMUNITY_BACKEND="json"

# COMMUNITY_STORE_PATH: JSON backend の保存先（既定: data/community.json）。
# Firestore backend では使用しない。
# git管理で追跡するのは data/community.json（.gitignore 参照）。
COMMUNITY_STORE_PATH="data/community.json"

# TRUST_PROXY_HOPS: number of trusted reverse-proxy hops for req.ip (rate-limit / vote guard).
# Default 1 (Cloud Run single proxy). Increase ONLY after reviewing CDN stages:
# trusting extra hops lets clients spoof X-Forwarded-For and bypass IP guards.
TRUST_PROXY_HOPS=1
